{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE '(^|[[:space:]|;&])(find|grep)([[:space:]]|$)'; then echo '{\"continue\": false, \"stopReason\": \"Use fff MCP tools instead of Bash find/grep: mcp__fff__find_files, mcp__fff__grep, or mcp__fff__multi_grep\"}'; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git *--force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git *--no-verify*)",
      "Bash(git *--no-gpg-sign*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo rm*)"
    ]
  }
}
